# Copy to .env for local use. Keep real database credentials out of Git.
# Set this to the pooled PostgreSQL connection string from your Neon project.
DATABASE_URL=

# Optional: reserve the direct/unpooled Neon URL for administrative scripts.
DATABASE_URL_UNPOOLED=

# Optional Django runtime settings
DJANGO_DEBUG=true

# Optional for local development; production requires persistent object storage.
# Cloudflare R2 S3-compatible settings (never commit real keys).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
# Public custom domain hostname only, without https://
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=auto
AWS_QUERYSTRING_AUTH=false
